<Page x:Class="_4.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_4"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LoginPage">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Введите логин" FontSize="26"/>
            <TextBox Name="LoginTB" Width="170" Height="35"/>
            <Button Name="LgnBtn" Content="Войти" Width="170" Height="55" Click="LgnBtn_Click"/>
            <Button Name="LgnHowGuest" Content="Войти как гость" Width="170" Height="55" Click="LgnHowGuest_Click"/>
        </StackPanel>
    </Grid>
</Page>
